# 强制 shell 脚本使用 LF 换行符（避免 Windows CRLF 导致 Docker 容器中 bash 报错）
*.sh text eol=lf
*.conf text eol=lf
acl text eol=lf

# Python 文件使用 LF（HA 容器中运行）
*.py text eol=lf

# YAML/JSON 使用 LF
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Markdown 使用本地默认换行符
*.md text=auto

# 二进制文件
*.png binary
*.base64 text eol=lf
